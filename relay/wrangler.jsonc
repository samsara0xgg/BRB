{
  // Relays the armed Mac's camera to the owner's phone, and the iPhone app's commands to the Mac.
  // Deploy: npx wrangler deploy. Optional APNs secrets for push to the app: npx wrangler secret put
  // APNS_KEY (and APNS_KEY_ID, APNS_TEAM_ID, APNS_TOPIC).
  "name": "guardmode-relay",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // The privacy policy and terms (legal/*.md), bundled as text for site.js.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // backin5.app has the pages, api.backin5.app is the host the apps pair with. workers.dev stays on
  // for the Macs and phones paired before 1.1: all three reach the same rooms.
  "routes": [
    { "pattern": "backin5.app", "custom_domain": true },
    { "pattern": "api.backin5.app", "custom_domain": true }
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "CODES", "class_name": "Codes" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Codes"] }
  ]
}
